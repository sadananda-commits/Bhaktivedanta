rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /quizzes/{quizId} { allow read: if true; allow write: if false; match /participants/{participantId} { allow read: if true; allow write: if false; } match /questions/{qNum} { allow read, write: if false; } match /answers/{answerId} { allow read, write: if false; } } match /quizSecrets/{quizId} { allow read, write: if false; } } }